# Copied to .env by install.sh. Do not commit the real .env.
# install.sh fills DOMAIN, BOT_TOKEN, ADMIN_IDS and generates the secrets.

# Public HTTPS domain for the Mini App, e.g. app.example.com
DOMAIN=app.example.com
WEBAPP_URL=https://app.example.com

# Token from @BotFather. Empty means the bot stays idle.
BOT_TOKEN=

# Comma-separated Telegram numeric IDs of administrators
ADMIN_IDS=

# Generated by install.sh
ADMIN_API_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Number of web processes (more = more simultaneous visitors, one CPU core each)
WEB_WORKERS=2

# Приблизительный пересчёт цен в карточке объявления: сколько рублей / долларов в 1 воне. 0 или пусто — не показывать.
# (курс теперь задаётся в админ-панели: «Тексты, FAQ, курс»; эти значения нужны только как запасные)
KRW_RUB=0
KRW_USD=0

# Mail (optional). Without SMTP_HOST the site sends no letters: no confirmation of e-mail and no restoring a password by mail.
# Example for a mailbox on your domain: SMTP_HOST=smtp.yandex.com SMTP_PORT=465 SMTP_USER=noreply@your-domain SMTP_PASSWORD=... SMTP_FROM="KOREA HUB <noreply@your-domain>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
