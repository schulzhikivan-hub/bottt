# Настройки, которые можно менять. Остальные скрипты читают их отсюда.
OWNER_USER=owner
TIMEZONE=Europe/Moscow

# Прокси только для Chrome с профилем TikTok. Пусто = без прокси.
# Формат: http://host:port или socks5://host:port. Логин и пароль сюда НЕ писать:
# используйте авторизацию по IP у провайдера, либо HTTP-прокси (Chrome сам спросит логин).
CHROME_PROXY=
